{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": [
    "src/vite-env.d.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "tests/unit/**/*.ts",
    "tests/unit/**/*.tsx",
    "tests/lint-fixtures/**/*.ts",
    "tests/lint-fixtures/**/*.tsx"
  ]
}
