{
  "name": "api-quiz-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "ApiQuiz: static client-only API interview quiz.",
  "engines": {
    "node": ">=22.18 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "lint:fixtures": "node tests/lint-fixtures/run-lint-fixtures.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "content:validate": "node -e \"console.log('no content validator yet (T-05)')\"",
    "size": "node scripts/check-size.mjs",
    "size:selftest": "node tests/size-fixtures/run-size-selftest.mjs",
    "check": "npm run lint && npm run lint:fixtures && npm run typecheck && npm run content:validate && npm run test"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
