{
  "name": "api-quiz-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "ApiQuiz: static client-only API interview quiz.",
  "engines": {
    "node": ">=22.18 <23"
  },
  "scripts": {
    "dev": "npm run content:build:dev && vite",
    "build": "npm run content:build && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "npm run content:build && tsc -b",
    "lint": "npm run content:build && eslint . --max-warnings 0",
    "lint:fixtures": "node tests/lint-fixtures/run-lint-fixtures.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run content:build && vitest run",
    "content:validate": "node scripts/validate-content.ts",
    "content:validate:release": "node scripts/validate-content.ts --release",
    "content:build": "node scripts/build-content.ts --mode production",
    "content:build:dev": "node scripts/build-content.ts --mode development",
    "content:check-dist": "node scripts/check-dist-content.mjs",
    "content:check-dist:selftest": "node tests/content-dist-fixtures/run-content-dist-selftest.mjs",
    "size": "node scripts/check-size.mjs",
    "size:selftest": "node tests/size-fixtures/run-size-selftest.mjs",
    "csp:check": "node scripts/check-dist-csp.mjs",
    "csp:selftest": "node tests/csp-fixtures/run-csp-selftest.mjs",
    "e2e": "playwright test",
    "e2e:chromium": "playwright test --project=\"chromium-*\"",
    "e2e:install": "playwright install --with-deps chromium webkit",
    "e2e:fixtures": "node tests/e2e/fixtures/validate-fixtures.ts",
    "check": "npm run lint && npm run lint:fixtures && npm run typecheck && npm run content:validate && npm run test",
    "lighthouse": "npx --yes --before=2026-10-08 @lhci/cli@0.15.1 autorun"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "overrides": {
    "playwright-core": "$@playwright/test",
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
